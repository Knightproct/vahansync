{
  "crons": [
    {
      "path": "/api/v1/telematics/cron-sync",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/signup",
      "destination": "/?page=signup"
    },
    {
      "source": "/app",
      "destination": "/?page=app"
    },
    {
      "source": "/invite/:token",
      "destination": "/?page=invite&token=:token"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
